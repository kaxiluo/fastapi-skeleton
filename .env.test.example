# 复制为 .env.test 后按本地环境填写；缺失 .env.test 时 integration 测试自动 skip
APP_ENV=testing
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
# 独立测试库，必须带 _test 后缀
DB_NAME=fastapi_test

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 独立测试 db
REDIS_DB=15

AUTH_JWT_SECRET=integration-test-secret
AUTH_DEBUG_VERIFICATION_CODE=747380
AUTH_JWT_TTL=1440
AUTH_VERIFICATION_CODE_TTL=180
AUTH_SEND_CODE_INTERVAL_SECONDS=60
AUTH_VERIFY_LOCK_SECONDS=900

LOG_LEVEL=WARNING
LOG_FORMAT=json
