# 应用
APP_NAME="FastAPI Skeleton"
APP_ENV=local                # local | testing | production
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fastapi

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 认证（AUTH_JWT_SECRET 必填，缺失或短于 32 字节启动即失败）
AUTH_JWT_SECRET=change-me-to-a-random-string-32-bytes-or-longer
# 万能验证码：仅 APP_ENV ∈ {local, testing} 时生效；production 必须显式置空（否则启动拒绝）
AUTH_DEBUG_VERIFICATION_CODE=747380
AUTH_JWT_TTL=1440
AUTH_VERIFICATION_CODE_TTL=180
AUTH_SEND_CODE_INTERVAL_SECONDS=60
AUTH_VERIFY_LOCK_SECONDS=900

# 日志
LOG_LEVEL=INFO
LOG_FORMAT=console           # console | json
LOG_FILE_ENABLE=false
LOG_RETENTION_DAYS=0             # 轮转备份保留天数；0=永不删除
